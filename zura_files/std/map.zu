const Map := struct {
    key: str,
    value: str,
};

const MapResult := struct {
    length: int!,
    value: str,
    index: int?,
};

const map_length := fn (map: *[]Map) int! {
    have count: int! = 0;

    if (map == nil) return 0; # Return 0 if the map is nil

    loop (i = 0; i < 2147483647) : (i++) {
        if (map&[i].key == nil) break; # Stop when we reach a null pointer
        count++;
    }

    return count;
};

const debug_print_map := fn (map: *[]Map, len: int) void {
    @outputln(1, "Debugging Map:");
    loop (i = 0; i < len) : (i++) {
        if (map&[i].key == nil) break; # Skip nil keys
        @outputln(1, "Index ", i, ": Key: ", map&[i].key, ", Value: ", map&[i].value);
    }
};

const print_map := fn (map: *[]Map, len: int) void {
    loop (i = 0; i < len) : (i++) {
        if (map&[i].key == nil) continue; # Skip nil keys
        @outputln(1, "Key: ", map&[i].key, ", Value: ", map&[i].value);
    }
};

const has_key := fn (map: *[]Map, key: str, len: int) bool {
    loop (i = 0; i < len) : (i++) {
        if (@streq(map&[i].key, key)) return true;
    }
    return false;
};

const add_key := fn (map: *[]Map, key: str, value: str) bool {
    return false; # Return false if the map is full
};

const remove_key := fn (map: *[]Map, key: str) bool {
    have len: int! = map_length(map);

    loop (i = 0; i < len) : (i++) {
        if (@streq(map&[i].key, key)) {
            have next_key: str = map&[i + 1].key;
            have next_value: str = map&[i + 1].value;

            if (next_key == nil) {
                map&[i].key = nil; # Clear the current key
                map&[i].value = nil; # Clear the current value
                # @outputln(1, "Removed key: ", key, " at index ", i);
                return true; # Return true to indicate the key was removed
            }

            map&[i].key = next_key; # Shift the next key to the current position
            map&[i].value = next_value; # Shift the next value to the current

            map&[i + 1].key = nil; # Clear the next position
            map&[i + 1].value = nil; # Clear the next value

            # @outputln(1, "Removed key: ", key, " at index ", i);`
            return true; # Return true to indicate the key was removed
        }
    }

    return false;
};

const get_value := fn (map: *[]Map, key: str, len: int) MapResult {
    have r: MapResult = {
        length: len,
        value: "Key not found",
        index: 0,
    };

    # Note: Arrays are stored in reverse order, when we pass them to this function
    loop (i = 0; i < r.length) : (i++) {
        if (@streq(map&[i].key, key)) {
            have index: int = i;
            @outputln(1, "Found key: ", key, " at index ", i);
            have val: str = map&[i].value;
            r.value = val;
            r.index = index;
            return r;
        }
    }

    return r;
};