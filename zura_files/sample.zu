@import "std/map.zu";

const main := fn () int! {
    have map: [5]Map = [
        { key: "name", value: "Zura" },
        { key: "version", value: "1.0.0" },
        { key: "author", value: "OpenAI" },
        { key: "license", value: "MIT" },
        { key: "description", value: "A sample map for testing" },
    ];

    @outputln(1, "Initial Map:");
    debug_print_map(&map, 5); # Debugging the map
    remove_key(&map, "version"); # Remove the "version" key
    remove_key(&map, "author"); # Remove the "author" key

    debug_print_map(&map, 5); # Debugging the map after removal


    return 0;
};
