@import "std/map.zu";

const main := fn () int! {
    have map: [4]Map = [
        { key: "name", value: "Zura" },
        { key: "version", value: "1.0.0" },
        { key: "author", value: "OpenAI" },
        { key: "license", value: "MIT" },
    ];

    have key: str = "author";
    have len: int! = map_length(&map);

    print_map(&map, len);

    if (has_key(&map, key, len)) {
        @outputln(1, "\nKey '", key, "' exists in the map.");
    } else {
        @outputln(1, "Key '", key, "' does not exist in the map.");
    }

    have value: MapResult = get_value(&map, key, len);
    @outputln(1, "Value for key '", key, "': ", value.value, " (at index ", value.index, ")");

    return 0;
};
